# Nebius Token Factory (required for embeddings + Nemotron explanations; app falls back without it)
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
CHAT_MODEL=nvidia/Nemotron-3_5-Lightning
# Check the embedding catalog in the Token Factory console and set the exact model ID here
EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# OpenAlex: free key from https://openalex.org/settings/api (shared IP budget is tiny without it)
OPENALEX_API_KEY=
OPENALEX_MAILTO=

CACHE_DIR=.cache
