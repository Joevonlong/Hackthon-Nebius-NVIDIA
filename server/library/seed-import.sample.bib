@article{tirosh2016,
  author        = {Tirosh, Itay and Izar, Benjamin and Prakadan, Sanjay M. and others},
  title         = {{Dissecting the multicellular ecosystem of metastatic melanoma by single-cell {RNA}-seq}},
  journal       = {Science},
  year          = {2016},
  volume        = {352},
  doi           = {10.1126/science.aad0501},
  pmid          = {27124452},
  url           = {https://www.science.org/doi/10.1126/science.aad0501},
  abstract      = {To explore the distinct genotypic and phenotypic states of melanoma tumors, we applied single-cell RNA sequencing (RNA-seq) to 4645 single cells isolated from 19 patients, profiling malignant, immune, stromal, and endothelial cells. Malignant cells within the same tumor displayed transcriptional heterogeneity associated with the cell cycle, spatial context, and a drug-resistance program. In particular, all tumors harbored malignant cells from two distinct transcriptional cell states, such that the clinically relevant MITF and AXL programs were expressed in {mutually exclusive} cells. Cell-to-cell interactions are discussed at length in the paper, and this abstract is deliberately long to resemble a real export, which often carries well over a thousand characters of prose per entry, with {nested {braces}} and "quotes" inside it. Further text follows to pad the field beyond one thousand characters so that the parser has to skip over it without trouble: single-cell profiling, immune checkpoint blockade, T cell exhaustion, tumor microenvironment, and clonal evolution are all topics covered by the study and its supplement.},
  keywords      = {melanoma, scRNA-seq}
}

