# Copy to .env.local at the repo root (worktrees find it by walking up).
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
TAVILY_API_KEY=
OPENALEX_API_KEY=
OPENALEX_MAILTO=
# Models (D-04)
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
EMBED_DIMS=1024
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
JUDGE_MODEL=nvidia/Nemotron-3_5-Lightning
PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b
SCOUT_MODEL=nvidia/nemotron-3-super-120b-a12b
# Run size overrides (D-16); unset = preset value
# RERANK_TOP_K=60
# JUDGE_TOP_K=30
PORT=3000
DATA_DIR=./data
# Google Scholar via SerpAPI (optional; Library mode skips Scholar without it — never scraped)
SERPAPI_KEY=
