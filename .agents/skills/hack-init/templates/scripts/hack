#!/usr/bin/env python3
"""Board CLI for hack-team hackathon repos. Python 3.8+, standard library only.

Every write is one small commit on the remote main branch, built with git
plumbing, so it works from any branch or worktree, never touches feature
branches, and retries when two people write at once. `scripts/hack -h` lists
the commands; hack/BOARD.md explains the board format.
"""
import argparse
import datetime as dt
import json
import os
import random
import re
import shutil
import subprocess
import sys
import tempfile
import time

REMOTE = os.environ.get("HACK_REMOTE", "origin")
MAIN = os.environ.get("HACK_MAIN", "main")
BOARD = "hack/BOARD.md"
EVENT = "hack/HACKATHON.md"
DECISIONS = "hack/DECISIONS.md"
COLUMNS = ["ID", "Feature", "Beat", "P", "Size", "Lane", "Deps", "Owner", "Status", "Updated", "Evidence"]
STATUSES = ("todo", "doing", "blocked", "done", "cut")
PRIORITIES = ("P0", "P1", "P2")
SIZES = {"S": 1.0, "M": 3.0}
DEFAULT_LANES = ("fe", "be", "ai", "infra", "design", "story")
PHASES = [("kickoff", 0.0), ("grill", 0.04), ("plan", 0.12), ("build", 0.20),
          ("harden", 0.70), ("ship", 0.85), ("submit", 0.95)]
MILESTONES = [(0.12, "G1 pitch lock"), (0.20, "G2 scope lock"), (0.30, "sync 30%"),
              (0.40, "sync 40%"), (0.50, "sync 50%"), (0.60, "sync 60%"),
              (0.70, "feature freeze"), (0.90, "code freeze"), (1.0, "submit_by")]
SETTABLE = {"title": "Feature", "feature": "Feature", "beat": "Beat", "p": "P", "size": "Size", "lane": "Lane",
            "deps": "Deps", "owner": "Owner", "status": "Status", "evidence": "Evidence"}


class HackError(Exception):
    pass


def warn(msg):
    print("hack: " + msg, file=sys.stderr)


# --------------------------------------------------------------------------- git

def git(*args, cwd=None, env=None, stdin=None, check=True):
    proc = subprocess.run(["git"] + list(args), cwd=cwd, env=env, input=stdin,
                          capture_output=True, text=True, encoding="utf-8")
    if check and proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        raise HackError("git %s failed: %s" % (" ".join(args), detail))
    return proc


def git_out(*args, **kw):
    return git(*args, **kw).stdout.strip()


class Repo:
    def __init__(self, force_local=False):
        proc = git("rev-parse", "--show-toplevel", check=False)
        if proc.returncode != 0:
            raise HackError("not inside a git repository")
        self.top = proc.stdout.strip()
        common = git_out("rev-parse", "--git-common-dir")
        if not os.path.isabs(common):
            common = os.path.abspath(os.path.join(os.getcwd(), common))
        self.main_root = os.path.dirname(common) if os.path.basename(common) == ".git" else self.top
        self.has_remote = REMOTE in git_out("remote").split()
        self.force_local = force_local or not self.has_remote
        self.remote_main_missing = False

    def sha(self, ref):
        proc = git("rev-parse", "--verify", "--quiet", ref + "^{commit}", check=False)
        return proc.stdout.strip() if proc.returncode == 0 else None

    def local_mode(self):
        return self.force_local or self.remote_main_missing

    def base(self, fetch=True):
        if not self.force_local:
            if fetch:
                proc = git("fetch", "--quiet", REMOTE, MAIN, check=False)
                if proc.returncode != 0 and "couldn't find remote ref" not in proc.stderr:
                    warn("fetch failed, using last known %s/%s: %s" % (REMOTE, MAIN, proc.stderr.strip()[:160]))
            sha = self.sha("refs/remotes/%s/%s" % (REMOTE, MAIN))
            if sha:
                self.remote_main_missing = False
                return sha
            self.remote_main_missing = True
        sha = self.sha("refs/heads/" + MAIN)
        if not sha:
            raise HackError("no %s branch yet; commit the hack-init scaffold first" % MAIN)
        return sha

    def read(self, sha, path):
        proc = git("show", "%s:%s" % (sha, path), check=False)
        return proc.stdout if proc.returncode == 0 else None

    def commit_tree(self, base, files, message):
        fd, index = tempfile.mkstemp(prefix="hack-index-")
        os.close(fd)
        env = dict(os.environ, GIT_INDEX_FILE=index)
        env.setdefault("GIT_AUTHOR_NAME", git_out("config", "user.name", check=False) or "hack-cli")
        env.setdefault("GIT_AUTHOR_EMAIL", git_out("config", "user.email", check=False) or "hack-cli@localhost")
        env.setdefault("GIT_COMMITTER_NAME", env["GIT_AUTHOR_NAME"])
        env.setdefault("GIT_COMMITTER_EMAIL", env["GIT_AUTHOR_EMAIL"])
        try:
            git("read-tree", base, env=env)
            for path, content in files.items():
                blob = git_out("hash-object", "-w", "--stdin", stdin=content, env=env)
                git("update-index", "--add", "--cacheinfo", "100644,%s,%s" % (blob, path), env=env)
            tree = git_out("write-tree", env=env)
            return git_out("commit-tree", tree, "-p", base, "-m", message, env=env)
        finally:
            os.unlink(index)

    def push(self, commit):
        proc = git("push", "--quiet", "--no-verify", REMOTE, "%s:refs/heads/%s" % (commit, MAIN), check=False)
        return proc.returncode == 0, (proc.stderr or proc.stdout).strip()

    def main_worktree(self):
        path = None
        for line in git_out("worktree", "list", "--porcelain").splitlines():
            if line.startswith("worktree "):
                path = line[len("worktree "):]
            elif line == "branch refs/heads/" + MAIN:
                return path
        return None

    def current_branch(self):
        return git_out("rev-parse", "--abbrev-ref", "HEAD", check=False)

    def write_local(self, base, files, message):
        """Commit to local main when there is no remote main to push to."""
        checkout = self.main_worktree()
        if checkout:
            paths = list(files)
            if git("diff", "--quiet", "HEAD", "--", *paths, cwd=checkout, check=False).returncode != 0:
                raise HackError("%s has uncommitted edits to %s; commit or discard them first"
                                % (checkout, ", ".join(paths)))
            if git_out("rev-parse", "HEAD", cwd=checkout) != base:
                raise HackError("main moved while writing; run the command again")
            for path, content in files.items():
                target = os.path.join(checkout, path)
                os.makedirs(os.path.dirname(target), exist_ok=True)
                with open(target, "w", encoding="utf-8") as fh:
                    fh.write(content)
            git("add", "--", *paths, cwd=checkout)
            git("commit", "--quiet", "--no-verify", "-m", message, "--", *paths, cwd=checkout)
            return git_out("rev-parse", "HEAD", cwd=checkout)
        commit = self.commit_tree(base, files, message)
        git("update-ref", "refs/heads/" + MAIN, commit, base)
        return commit

    def follow_main(self):
        if self.current_branch() == MAIN:
            proc = git("merge", "--ff-only", "--quiet", "%s/%s" % (REMOTE, MAIN), check=False)
            if proc.returncode != 0:
                warn("local %s could not fast-forward; run `git pull --rebase`" % MAIN)


def transact(repo, mutate, attempts=5):
    """Read current files from main, apply `mutate`, commit, push; retry on races."""
    for attempt in range(attempts):
        base = repo.base(fetch=True)
        files, message, report = mutate(lambda path: repo.read(base, path))
        if not files:
            print(report)
            return
        message += " [skip ci]"
        if repo.local_mode():
            commit = repo.write_local(base, files, message)
            if not repo.has_remote:
                why = "no remote configured"
            elif repo.force_local:
                why = "--local; push %s later" % MAIN
            else:
                why = "%s/%s does not exist yet; push %s to share the board" % (REMOTE, MAIN, MAIN)
            print("%s\ncommitted %s on local %s (%s)" % (report, commit[:7], MAIN, why))
            return
        commit = repo.commit_tree(base, files, message)
        ok, err = repo.push(commit)
        if ok:
            repo.follow_main()
            print("%s\npushed %s to %s/%s" % (report, commit[:7], REMOTE, MAIN))
            return
        if not re.search(r"rejected|non-fast-forward|fetch first|failed to update ref|stale info", err):
            raise HackError("push failed, board unchanged: %s\nRetry when online, or pass --local." % err[:300])
        time.sleep(0.3 + random.random() * 0.7 * (attempt + 1))
    raise HackError("main kept moving; board unchanged. Run the command again.")


# --------------------------------------------------------------------------- parsing

def strip_comment(line):
    quote = None
    for i, ch in enumerate(line):
        if ch in "\"'":
            quote = None if quote == ch else (quote or ch)
        elif ch == "#" and quote is None and (i == 0 or line[i - 1] in " \t"):
            return line[:i].rstrip()
    return line.rstrip()


def unquote(value):
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    if value.startswith("[") and value.endswith("]"):
        return [unquote(v) for v in value[1:-1].split(",") if v.strip()]
    return value


def parse_frontmatter(text):
    match = re.match(r"^---[ \t]*\n(.*?)\n---[ \t]*(\n|$)", text or "", re.S)
    data, current = {}, None
    if not match:
        return data
    for raw in match.group(1).splitlines():
        line = strip_comment(raw)
        if not line.strip():
            continue
        if not raw[:1].isspace():
            key, _, value = line.partition(":")
            key, value = key.strip(), value.strip()
            current = key if value == "" else None
            data[key] = {} if value == "" else unquote(value)
        elif current is not None:
            item = line.strip()
            if item.startswith("- "):
                if not isinstance(data[current], list):
                    data[current] = []
                data[current].append(unquote(item[2:]))
            elif isinstance(data[current], dict):
                key, _, value = item.partition(":")
                data[current][key.strip()] = unquote(value)
    return data


def parse_time(value, name="time"):
    text = str(value or "").strip().strip("\"'")
    if not text or "<" in text:
        raise HackError("%s is not set in %s" % (name, EVENT))
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        stamp = dt.datetime.fromisoformat(text.replace(" ", "T", 1))
    except ValueError:
        raise HackError("%s %r is not ISO 8601 like 2026-10-18T09:00+02:00" % (name, value))
    if stamp.tzinfo is None:
        stamp = stamp.astimezone()
    return stamp


class Event:
    def __init__(self, text):
        if text is None:
            raise HackError("%s not found on main; run the hack-init skill" % EVENT)
        self.data = parse_frontmatter(text)
        self.start = parse_time(self.data.get("start"), "start")
        self.submit_by = parse_time(self.data.get("submit_by"), "submit_by")
        deadline = self.data.get("deadline")
        self.deadline = parse_time(deadline, "deadline") if deadline and "<" not in str(deadline) else None
        if self.submit_by <= self.start:
            raise HackError("submit_by must be after start")
        self.tz = self.start.tzinfo
        lanes = self.data.get("lanes")
        self.lanes = lanes if isinstance(lanes, dict) and lanes else {k: "" for k in DEFAULT_LANES}

    def num(self, key, default):
        try:
            return int(str(self.data.get(key, default)))
        except ValueError:
            return default

    def now(self):
        fake = os.environ.get("HACK_NOW")
        return parse_time(fake, "HACK_NOW").astimezone(self.tz) if fake else dt.datetime.now(self.tz)

    def at(self, share):
        return self.start + (self.submit_by - self.start) * share

    def progress(self, now):
        return (now - self.start).total_seconds() / (self.submit_by - self.start).total_seconds()

    def phase(self, now):
        share = self.progress(now)
        if share < 0:
            return "pre-start"
        if share >= 1:
            return "past submit_by"
        return [name for name, begin in PHASES if share >= begin][-1]


class Board:
    def __init__(self, text):
        if text is None:
            raise HackError("%s not found on main; run the hack-init skill" % BOARD)
        lines = text.splitlines()
        head = next((i for i, l in enumerate(lines) if re.match(r"^\|\s*ID\s*\|", l)), None)
        if head is None:
            raise HackError("%s has no table header starting with '| ID |'" % BOARD)
        names = [c.strip() for c in lines[head].strip().strip("|").split("|")]
        self.pre, self.rows = lines[:head], []
        index = head + 2
        while index < len(lines) and lines[index].lstrip().startswith("|"):
            cells = [c.strip() for c in lines[index].strip().strip("|").split("|")]
            row = {c: "" for c in COLUMNS}
            row.update({n: v for n, v in zip(names, cells) if n in row})
            if row["ID"]:
                self.rows.append(row)
            index += 1
        self.post = lines[index:]

    def get(self, card):
        card = normalize_id(card)
        for row in self.rows:
            if row["ID"] == card:
                return row
        raise HackError("%s is not on the board" % card)

    def render(self):
        def cell(value):
            return str(value).replace("|", "/").replace("\n", " ").strip()
        out = list(self.pre)
        out.append("| " + " | ".join(COLUMNS) + " |")
        out.append("|" + "|".join("----" for _ in COLUMNS) + "|")
        for row in self.rows:
            out.append("| " + " | ".join(cell(row[c]) for c in COLUMNS) + " |")
        out.extend(self.post)
        return "\n".join(out).rstrip("\n") + "\n"

    def log(self, line):
        if not any(l.strip().lower() == "## log" for l in self.post):
            self.post += ["", "## Log", ""]
        while self.post and not self.post[-1].strip():
            self.post.pop()
        if self.post[-1].strip().lower() == "## log":
            self.post.append("")
        self.post.append("- " + line)

    def log_lines(self):
        seen, out = False, []
        for line in self.post:
            if line.strip().lower() == "## log":
                seen = True
            elif seen and line.startswith("- "):
                out.append(line[2:])
        return out


def normalize_id(card):
    match = re.match(r"^[Ff]-?(\d{1,2})$", card.strip())
    if not match:
        raise HackError("card ids look like F-03, got %r" % card)
    return "F-%02d" % int(match.group(1))


def deps_of(row):
    return [normalize_id(d) for d in re.split(r"[,\s]+", row["Deps"]) if d and d not in ("—", "-")]


def stamp(event, now):
    return now.strftime("%m-%d %H:%M")


def parse_stamp(event, value, now):
    try:
        moment = dt.datetime.strptime("%d-%s" % (event.start.year, value.strip()), "%Y-%m-%d %H:%M")
    except ValueError:
        return None
    moment = moment.replace(tzinfo=event.tz)
    if moment - now > dt.timedelta(days=200):
        moment = moment.replace(year=moment.year - 1)
    elif now - moment > dt.timedelta(days=200):
        moment = moment.replace(year=moment.year + 1)
    return moment


def human(owner):
    return owner.split("@")[-1].strip().lower()


def minutes(delta):
    return int(delta.total_seconds() // 60)


def fmt_minutes(total):
    sign = "-" if total < 0 else ""
    total = abs(int(total))
    return "%s%dh%02dm" % (sign, total // 60, total % 60) if total >= 60 else "%s%dm" % (sign, total)


# --------------------------------------------------------------------------- board logic

class Ctx:
    def __init__(self, read):
        self.event = Event(read(EVENT))
        self.board = Board(read(BOARD))
        self.read = read
        self.now = self.event.now()

    def ready_since(self, row):
        """When the card became claimable: the later of its own and its deps' last update."""
        times = [parse_stamp(self.event, row["Updated"], self.now)]
        for dep in deps_of(row):
            try:
                times.append(parse_stamp(self.event, self.board.get(dep)["Updated"], self.now))
            except HackError:
                pass
        times = [t for t in times if t]
        return max(times) if times else self.event.start

    def open_deps(self, row):
        out = []
        for dep in deps_of(row):
            try:
                if self.board.get(dep)["Status"] != "done":
                    out.append(dep)
            except HackError:
                out.append(dep + "?")
        return out

    def is_ready(self, row):
        return row["Status"] == "todo" and not self.open_deps(row)

    def is_stale(self, row):
        if row["Status"] != "doing":
            return False
        updated = parse_stamp(self.event, row["Updated"], self.now)
        limit = self.event.num("stale_after_minutes", 45)
        return bool(updated) and minutes(self.now - updated) >= limit

    def lane_owners(self, lane):
        value = self.event.lanes.get(lane, "")
        return {h.strip().lower() for h in str(value).split(",") if h.strip() and "<" not in h}

    def own_lane(self, row, who):
        owners = self.lane_owners(row["Lane"])
        return not owners or human(who) in owners

    def stealable_at(self, row):
        return self.ready_since(row) + dt.timedelta(minutes=self.event.num("steal_after_minutes", 15))

    def touch(self, row, who, action, detail=""):
        row["Updated"] = stamp(self.event, self.now)
        line = "%s %s %s %s" % (row["Updated"], who, action, row["ID"])
        self.board.log(line + (" — " + detail if detail else ""))

    def save(self, message, report, extra=None):
        files = {BOARD: self.board.render()}
        files.update(extra or {})
        return files, message, report


def who_am_i(args):
    name = getattr(args, "as_", None) or os.environ.get("HACK_AS")
    if not name:
        name = git_out("config", "user.name", check=False) or os.environ.get("USER", "someone")
    return name.strip().replace("|", "/")


def row_line(row):
    owner = row["Owner"] or "-"
    return "%s  %-7s %-2s %-1s %-6s %-16s %s" % (
        row["ID"], row["Status"], row["P"], row["Size"] or "?", row["Lane"], owner, row["Feature"])


def gate_state(read, ctx):
    pitch, spec, design = read("hack/PITCH.md"), read("hack/SPEC.md"), read("hack/DESIGN.md")
    locked = re.compile(r"(?im)^[>*_\s-]*status[*_\s]*:[*_\s]*locked\b")
    direction = re.compile(r"(?im)^[>*_\s-]*direction[*_\s]*:[*_\s]*[^<\s].*$")
    f00 = next((r for r in ctx.board.rows if r["ID"] == "F-00"), None)
    return {
        "G1 pitch lock": bool(pitch and locked.search(pitch)),
        "G2 spec lock": bool(spec and locked.search(spec)),
        "G2 direction": any("assumed" not in m.group(0).lower() for m in direction.finditer(design or "")),
        "F-00 live": bool(f00 and f00["Status"] == "done"),
    }


def cmd_status(args, repo):
    def view(read):
        ctx = Ctx(read)
        ev, now, rows = ctx.event, ctx.now, ctx.board.rows
        share = ev.progress(now)
        upcoming = [(ev.at(s), name) for s, name in MILESTONES if ev.at(s) > now][:3]
        counts = {s: sum(1 for r in rows if r["Status"] == s) for s in STATUSES}
        p0 = [r for r in rows if r["P"] == "P0" and r["Status"] != "cut"]
        doing = [r for r in rows if r["Status"] == "doing"]
        stale = [r for r in doing if ctx.is_stale(r)]
        ready = sorted((r for r in rows if ctx.is_ready(r)), key=lambda r: (r["P"], r["ID"]))
        blocked = [r for r in rows if r["Status"] == "blocked"]
        gates = gate_state(read, ctx)
        p0_left = sum(SIZES.get(r["Size"], 3.0) for r in p0 if r["Status"] not in ("done", "cut"))
        freeze_left = max(0, minutes(ev.at(0.70) - now)) / 60.0
        data = {
            "event": ev.data.get("event", ""), "project": ev.data.get("project", ""),
            "now": now.isoformat(timespec="minutes"), "phase": ev.phase(now),
            "progress": round(share, 3), "minutes_to_submit_by": minutes(ev.submit_by - now),
            "submit_by": ev.submit_by.isoformat(timespec="minutes"),
            "deadline": ev.deadline.isoformat(timespec="minutes") if ev.deadline else None,
            "upcoming": [{"at": t.isoformat(timespec="minutes"), "what": n} for t, n in upcoming],
            "gates": gates, "counts": counts,
            "p0_done": sum(1 for r in p0 if r["Status"] == "done"), "p0_total": len(p0),
            "p0_hours_left": p0_left, "hours_to_freeze": round(freeze_left, 1),
            "doing": doing, "stale": stale, "ready": ready, "blocked": blocked,
            "log": ctx.board.log_lines()[-5:], "prod_url": ev.data.get("prod_url", ""),
        }
        if args.json:
            return None, "", json.dumps(data, indent=2, ensure_ascii=False)
        out = ["hack · %s · %s" % (data["event"] or "event", data["project"] or "project"),
               "Now %s · phase %s (%d%%) · %s left to submit_by %s%s" % (
                   now.strftime("%m-%d %H:%M"), data["phase"], round(share * 100),
                   fmt_minutes(data["minutes_to_submit_by"]), ev.submit_by.strftime("%m-%d %H:%M"),
                   " · deadline " + ev.deadline.strftime("%m-%d %H:%M") if ev.deadline else "")]
        if upcoming:
            out.append("Next: " + " · ".join("%s %s" % (n, t.strftime("%m-%d %H:%M")) for t, n in upcoming))
        out.append("Gates: " + " · ".join("%s %s" % (k, "yes" if v else "no") for k, v in gates.items()))
        out.append("Board: P0 %d/%d done · doing %d · blocked %d · todo %d · done %d · cut %d" % (
            data["p0_done"], data["p0_total"], counts["doing"], counts["blocked"], counts["todo"],
            counts["done"], counts["cut"]))
        out.append("Burn-down: P0 work left ~%.0fh (S=1h, M=3h) · %.1fh to feature freeze per builder" % (
            p0_left, freeze_left))
        out.append("Prod: " + (data["prod_url"] or "not deployed"))
        for title, group in (("Doing", doing), ("Stale", stale), ("Ready", ready[:8]), ("Blocked", blocked)):
            if group:
                out.append(title + ":")
                for row in group:
                    extra = ""
                    if title in ("Doing", "Stale"):
                        since = parse_stamp(ev, row["Updated"], now)
                        extra = "  (%s)" % fmt_minutes(minutes(now - since)) if since else ""
                    if title == "Blocked" and row["Evidence"]:
                        extra = "  — " + row["Evidence"]
                    out.append("  " + row_line(row) + extra)
        if data["log"]:
            out.append("Log:")
            out.extend("  " + line for line in data["log"])
        return None, "", "\n".join(out)
    transact(repo, view)


def cmd_timeline(args, repo):
    def view(read):
        ev = Event(read(EVENT))
        now = ev.now()
        out = ["Window %s → %s (%s)" % (ev.start.strftime("%a %m-%d %H:%M"), ev.submit_by.strftime("%a %m-%d %H:%M"),
                                         fmt_minutes(minutes(ev.submit_by - ev.start)))]
        ends = [b for _, b in PHASES[1:]] + [1.0]
        for (name, begin), end in zip(PHASES, ends):
            mark = "  <- now" if ev.phase(now) == name else ""
            out.append("  %-8s %s → %s%s" % (name, ev.at(begin).strftime("%a %H:%M"), ev.at(end).strftime("%a %H:%M"), mark))
        out.append("Milestones:")
        for share, name in MILESTONES:
            out.append("  %-15s %s" % (name, ev.at(share).strftime("%a %m-%d %H:%M")))
        if ev.deadline:
            out.append("  %-15s %s" % ("official deadline", ev.deadline.strftime("%a %m-%d %H:%M")))
        return None, "", "\n".join(out)
    transact(repo, view)


def cmd_next(args, repo):
    who = who_am_i(args)

    def view(read):
        ctx = Ctx(read)
        picks = []
        for row in ctx.board.rows:
            if not ctx.is_ready(row) or (args.lane and row["Lane"] != args.lane):
                continue
            own = ctx.own_lane(row, who)
            if not own and ctx.stealable_at(row) > ctx.now:
                continue
            picks.append((0 if own else 1, row["P"], row["ID"], row))
        picks.sort(key=lambda p: p[:3])
        if not picks:
            return None, "", "No ready card for %s%s. Ask the captain, or run `scripts/hack status`." % (
                who, " in lane " + args.lane if args.lane else "")
        lines = ["Next for %s:" % who]
        for own, _, _, row in picks[:3]:
            lines.append("  " + row_line(row) + ("" if own == 0 else "  (other lane, stealable)"))
        lines.append("Claim with: scripts/hack claim %s" % picks[0][3]["ID"])
        return None, "", "\n".join(lines)
    transact(repo, view)


def cmd_claim(args, repo):
    who = who_am_i(args)

    def mutate(read):
        ctx = Ctx(read)
        row = ctx.board.get(args.id)
        status, owner = row["Status"], row["Owner"]
        if status in ("done", "cut"):
            raise HackError("%s is %s" % (row["ID"], status))
        if status == "doing" and human(owner) == human(who) and owner == who:
            return None, "", "%s is already yours" % row["ID"]
        action = "claim"
        if status in ("doing", "blocked") and owner and human(owner) != human(who):
            if not args.steal:
                raise HackError("%s is %s by %s since %s; use --steal only if it is stale" % (
                    row["ID"], status, owner, row["Updated"]))
            if status == "doing" and not ctx.is_stale(row) and not args.force:
                raise HackError("%s is not stale yet (stale after %d min)" % (
                    row["ID"], ctx.event.num("stale_after_minutes", 45)))
            action = "steal (from %s)" % owner
        if not args.force:
            open_deps = ctx.open_deps(row)
            if open_deps:
                raise HackError("%s waits on %s" % (row["ID"], ", ".join(open_deps)))
            active = [r for r in ctx.board.rows if r["Status"] == "doing" and r["Owner"] == who]
            if len(active) >= ctx.event.num("max_active", 2):
                raise HackError("%s already has %d active cards (%s); finish or release one" % (
                    who, len(active), ", ".join(r["ID"] for r in active)))
            if not ctx.own_lane(row, who) and ctx.stealable_at(row) > ctx.now:
                raise HackError("%s is in lane %s (owner %s); claimable by others at %s" % (
                    row["ID"], row["Lane"], ctx.event.lanes.get(row["Lane"]),
                    ctx.stealable_at(row).strftime("%H:%M")))
        row.update(Owner=who, Status="doing", Evidence="")
        ctx.touch(row, who, action + (" (forced)" if args.force else ""))
        return ctx.save("chore(board): %s %s by %s" % (action.split()[0], row["ID"], who),
                        "doing: " + row_line(row))
    transact(repo, mutate)


def simple_status(new_status, needs_text, verb):
    def run(args, repo):
        who = who_am_i(args)
        text = (getattr(args, "evidence", None) or getattr(args, "reason", None) or "").strip()
        if needs_text and not text:
            raise HackError("%s needs %s" % (verb, "--evidence" if new_status == "done" else "--reason"))

        def mutate(read):
            ctx = Ctx(read)
            row = ctx.board.get(args.id)
            if row["Status"] == "cut" and new_status != "todo":
                raise HackError("%s is cut; `scripts/hack set %s status=todo` to revive it" % (row["ID"], row["ID"]))
            row["Status"] = new_status
            if new_status == "todo":
                row["Owner"], row["Evidence"] = "", ""
            else:
                row["Evidence"] = text
                if not row["Owner"] and new_status != "cut":
                    row["Owner"] = who
            ctx.touch(row, who, verb, text)
            report = "%s: %s" % (new_status, row_line(row))
            if new_status == "cut" and row["P"] == "P0":
                report += "\nP0 cut: record the decision with scripts/hack decide \"...\""
            return ctx.save("chore(board): %s %s by %s" % (verb, row["ID"], who), report)
        transact(repo, mutate)
    return run


def cmd_add(args, repo):
    who = who_am_i(args)

    def mutate(read):
        ctx = Ctx(read)
        if args.p not in PRIORITIES:
            raise HackError("--p must be one of " + ", ".join(PRIORITIES))
        if args.lane not in ctx.event.lanes:
            raise HackError("lane %r is not in HACKATHON.md lanes: %s" % (args.lane, ", ".join(ctx.event.lanes)))
        if args.size not in SIZES:
            raise HackError("--size must be S (about 1 h) or M (about 3 h); split anything bigger")
        deps = [normalize_id(d) for d in re.split(r"[,\s]+", args.deps or "") if d]
        for dep in deps:
            ctx.board.get(dep)
        numbers = [int(r["ID"][2:]) for r in ctx.board.rows if re.match(r"^F-\d+$", r["ID"])]
        card = normalize_id(args.id) if args.id else "F-%02d" % (max(numbers + [0]) + 1)
        if any(r["ID"] == card for r in ctx.board.rows):
            raise HackError("%s already exists" % card)
        if int(card[2:]) > 99:
            raise HackError("board is full (F-99); merge or cut cards")
        row = {c: "" for c in COLUMNS}
        row.update(ID=card, Feature=args.title, Beat=args.beat or "—", P=args.p, Size=args.size, Lane=args.lane,
                   Deps=", ".join(deps) or "—", Status="todo")
        ctx.board.rows.append(row)
        ctx.touch(row, who, "add", args.title)
        return ctx.save("chore(board): add %s by %s" % (card, who), "added: " + row_line(row))
    transact(repo, mutate)


def cmd_set(args, repo):
    who = who_am_i(args)
    changes = {}
    for pair in args.fields:
        key, sep, value = pair.partition("=")
        if not sep or key.lower() not in SETTABLE:
            raise HackError("fields look like p=P1, allowed: " + ", ".join(sorted(SETTABLE)))
        changes[SETTABLE[key.lower()]] = value.strip()

    def mutate(read):
        ctx = Ctx(read)
        row = ctx.board.get(args.id)
        for column, value in changes.items():
            if column == "P" and value not in PRIORITIES:
                raise HackError("P must be one of " + ", ".join(PRIORITIES))
            if column == "Size" and value not in SIZES:
                raise HackError("size must be S or M")
            if column == "Status" and value not in STATUSES:
                raise HackError("status must be one of " + ", ".join(STATUSES))
            if column == "Lane" and value not in ctx.event.lanes:
                raise HackError("lane %r is not in HACKATHON.md lanes" % value)
            if column == "Deps":
                deps = [normalize_id(d) for d in re.split(r"[,\s]+", value) if d and d not in ("—", "-")]
                for dep in deps:
                    ctx.board.get(dep)
                value = ", ".join(deps) or "—"
            row[column] = value
        detail = ", ".join("%s=%s" % (k.lower(), v) for k, v in changes.items())
        ctx.touch(row, who, "set", detail)
        return ctx.save("chore(board): set %s by %s" % (row["ID"], who), "updated: " + row_line(row))
    transact(repo, mutate)


def cmd_decide(args, repo):
    who = who_am_i(args)

    def mutate(read):
        ctx = Ctx(read)
        text = read(DECISIONS) or "# Decisions\n"
        numbers = [int(n) for n in re.findall(r"\bD-(\d+)\b", text)]
        ident = "D-%02d" % (max(numbers + [0]) + 1)
        line = "- %s · %s · %s · %s" % (ident, stamp(ctx.event, ctx.now), who, args.text.strip())
        new_text = text.rstrip("\n") + "\n" + line + "\n"
        return {DECISIONS: new_text}, "chore(board): decision %s by %s" % (ident, who), line
    transact(repo, mutate)


def cmd_log(args, repo):
    who = who_am_i(args)

    def mutate(read):
        ctx = Ctx(read)
        line = "%s %s %s" % (stamp(ctx.event, ctx.now), who, args.text.strip())
        ctx.board.log(line)
        return ctx.save("chore(board): log by %s" % who, "logged: " + line)
    transact(repo, mutate)


EVENT_KEYS = {
    "prod_url": "url", "repo_url": "url", "video_url": "url", "submission_url": "url",
    "autonomy": ("local", "branch", "merge"), "merge_mode": ("pr", "direct"),
    "max_active": "int", "steal_after_minutes": "int", "stale_after_minutes": "int",
    "doc_language": "text", "submission_language": "text",
    "start": "time", "submit_by": "time", "deadline": "time",
}


def cmd_event(args, repo):
    """Set flat keys in the HACKATHON.md frontmatter, committed like a board change."""
    who = who_am_i(args)
    changes = []
    for item in args.fields:
        key, eq, value = item.partition("=")
        key, value = key.strip().lower(), value.strip()
        kind = EVENT_KEYS.get(key)
        if not eq or kind is None:
            raise HackError("use key=value with key in: %s" % ", ".join(sorted(EVENT_KEYS)))
        if isinstance(kind, tuple) and value not in kind:
            raise HackError("%s must be one of %s" % (key, ", ".join(kind)))
        if kind == "int" and not value.isdigit():
            raise HackError("%s must be a whole number" % key)
        if kind == "url" and value and not re.match(r"^https?://", value):
            raise HackError("%s must start with http:// or https://" % key)
        if kind == "time":
            parse_time(value, key)
        changes.append((key, '"%s"' % value.replace('"', "'") if kind == "url" else value))

    def mutate(read):
        text = read(EVENT)
        if text is None:
            raise HackError("%s not found on main; run the hack-init skill" % EVENT)
        match = re.match(r"^(---\n)(.*?)(\n---\n.*)$", text, re.S)
        if not match:
            raise HackError("%s has no frontmatter" % EVENT)
        head = match.group(2)
        for key, rendered in changes:
            line = "%s: %s" % (key, rendered)
            pattern = re.compile(r"(?m)^%s:.*$" % re.escape(key))
            head = pattern.sub(lambda _: line, head, count=1) if pattern.search(head) else head + "\n" + line
        new_text = match.group(1) + head + match.group(3)
        Event(new_text)  # refuse a change that breaks the clock
        summary = ", ".join("%s=%s" % (k, v.strip('"')) for k, v in changes)
        return {EVENT: new_text}, "chore(event): %s by %s" % (summary, who), "event: " + summary
    transact(repo, mutate)


def cmd_check(args, repo):
    def view(read):
        ctx = Ctx(read)
        problems, seen = [], set()
        for row in ctx.board.rows:
            if row["ID"] in seen:
                problems.append("%s appears twice" % row["ID"])
            seen.add(row["ID"])
            if row["Status"] not in STATUSES:
                problems.append("%s has unknown status %r" % (row["ID"], row["Status"]))
            if row["P"] not in PRIORITIES:
                problems.append("%s has unknown priority %r" % (row["ID"], row["P"]))
            if row["Lane"] not in ctx.event.lanes:
                problems.append("%s has unknown lane %r" % (row["ID"], row["Lane"]))
            if row["Size"] not in SIZES:
                problems.append("%s has size %r (use S or M)" % (row["ID"], row["Size"]))
            if row["Status"] == "done" and not row["Evidence"]:
                problems.append("%s is done without evidence" % row["ID"])
            if row["Status"] in ("doing", "blocked") and not row["Owner"]:
                problems.append("%s is %s without an owner" % (row["ID"], row["Status"]))
            for dep in deps_of(row):
                if dep not in {r["ID"] for r in ctx.board.rows}:
                    problems.append("%s depends on missing %s" % (row["ID"], dep))
        report = "\n".join(problems) if problems else "board ok: %d cards" % len(ctx.board.rows)
        if problems:
            raise HackError(report)
        return None, "", report
    transact(repo, view)


def slug(text):
    text = re.sub(r"^fix:\s*", "", text.strip(), flags=re.I)
    value = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return value[:32].rstrip("-") or "work"


def cmd_wt(args, repo):
    card = normalize_id(args.id)
    name = os.path.basename(repo.main_root)
    root = os.environ.get("HACK_WORKTREE_DIR")
    path = args.path or (os.path.join(os.path.expanduser(root), "%s-%s" % (name, card)) if root
                         else os.path.join(repo.main_root, ".worktrees", card))
    if args.remove:
        git("worktree", "remove", *(["--force"] if args.force else []), path)
        print("removed worktree %s" % path)
        return
    base = repo.base(fetch=True)
    title = ""
    try:
        title = Board(repo.read(base, BOARD)).get(card)["Feature"]
    except HackError:
        pass
    prefix = "fix" if title.lower().startswith("fix:") else "feat"
    branch = args.branch or "%s/%s-%s" % (prefix, card, slug(title or card))
    if os.path.exists(path):
        raise HackError("%s already exists; cd there or pass --remove" % path)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if repo.sha("refs/heads/" + branch):
        git("worktree", "add", path, branch)
        origin = "existing local branch"
    elif not repo.force_local and repo.sha("refs/remotes/%s/%s" % (REMOTE, branch)):
        git("worktree", "add", "-b", branch, path, "%s/%s" % (REMOTE, branch))
        origin = "existing %s/%s" % (REMOTE, branch)
    else:
        git("worktree", "add", "-b", branch, path, base)
        origin = "%s @ %s" % ("%s/%s" % (REMOTE, MAIN) if not repo.local_mode() else MAIN, base[:7])
    for env_file in (".env.local", ".env"):
        source = os.path.join(repo.main_root, env_file)
        if os.path.isfile(source) and not os.path.exists(os.path.join(path, env_file)):
            shutil.copy2(source, os.path.join(path, env_file))
    port = 3000 + int(card[2:])
    manager = "pnpm" if os.path.exists(os.path.join(path, "pnpm-lock.yaml")) else "npm"
    print("worktree: %s\nbranch:   %s (from %s)\nport:     %d\nnext:     cd %s && %s install && PORT=%d %s run dev"
          % (path, branch, origin, port, path, manager, port, manager))


# --------------------------------------------------------------------------- main

def build_parser():
    parser = argparse.ArgumentParser(prog="scripts/hack", description="hack-team board CLI")
    parser.add_argument("--local", action="store_true", help="commit to local main only, do not push")
    sub = parser.add_subparsers(dest="cmd")

    def add(name, func, help_text):
        p = sub.add_parser(name, help=help_text)
        p.set_defaults(func=func)
        p.add_argument("--as", dest="as_", help="owner name, e.g. frontend-dev@joe")
        return p

    p = add("status", cmd_status, "phase, time left, gates, claims, ready and stale cards")
    p.add_argument("--json", action="store_true")
    add("timeline", cmd_timeline, "absolute phase and milestone times")
    p = add("next", cmd_next, "best ready card for you")
    p.add_argument("--lane")
    p = add("claim", cmd_claim, "start a card")
    p.add_argument("id")
    p.add_argument("--steal", action="store_true", help="take a stale card from someone else")
    p.add_argument("--force", action="store_true", help="captain override of deps, lane, and limits")
    p = add("done", simple_status("done", True, "done"), "finish a card with evidence")
    p.add_argument("id")
    p.add_argument("--evidence", required=True)
    p = add("block", simple_status("blocked", True, "block"), "mark a card blocked")
    p.add_argument("id")
    p.add_argument("--reason", required=True)
    p = add("release", simple_status("todo", False, "release"), "give a card back")
    p.add_argument("id")
    p = add("cut", simple_status("cut", True, "cut"), "cut a card from scope")
    p.add_argument("id")
    p.add_argument("--reason", required=True)
    p = add("add", cmd_add, "add a card")
    p.add_argument("title")
    p.add_argument("--beat", default="—")
    p.add_argument("--p", required=True)
    p.add_argument("--size", default="M", help="S (about 1 h) or M (about 3 h); default M")
    p.add_argument("--lane", required=True)
    p.add_argument("--deps", default="")
    p.add_argument("--id", help="explicit id, e.g. F-00")
    p = add("set", cmd_set, "edit fields: p=P1 lane=be deps=F-01 title=...")
    p.add_argument("id")
    p.add_argument("fields", nargs="+")
    p = add("event", cmd_event, "set HACKATHON.md keys, e.g. prod_url=https://x.vercel.app")
    p.add_argument("fields", nargs="+")
    p = add("decide", cmd_decide, "append a decision to hack/DECISIONS.md")
    p.add_argument("text")
    p = add("log", cmd_log, "append a line to the board log")
    p.add_argument("text")
    add("check", cmd_check, "validate the board")
    p = add("wt", cmd_wt, "create or remove the worktree for a card")
    p.add_argument("id")
    p.add_argument("--remove", action="store_true")
    p.add_argument("--force", action="store_true")
    p.add_argument("--path")
    p.add_argument("--branch")
    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        return 0
    try:
        args.func(args, Repo(force_local=args.local))
    except HackError as error:
        warn(str(error))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
